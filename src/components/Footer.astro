---
import type { Translations } from '../i18n';

interface Props {
  translations: Translations;
}

const { translations } = Astro.props;
---

<footer class="mt-auto border-t border-[#AEAC78]/30 dark:border-[#AEAC78]/20 bg-[#FCF0DA]/60 dark:bg-[#4C4541]/60 transition-colors duration-200">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#4C4541]/80 dark:text-[#FCF0DA]/70">
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left">
        <p class="font-medium">{translations.footer.tagline}</p>
        <span class="hidden sm:inline text-[#AEAC78]" aria-hidden="true">•</span>
        <p class="flex items-center gap-1.5 text-[#AEAC78] dark:text-[#AEAC78]">
          <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>{translations.footer.privacy}</span>
        </p>
      </div>

      <div class="flex items-center gap-4">
        <a
          href="https://ko-fi.com/kishara"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 font-semibold text-[#4C4541] dark:text-[#FCF0DA] hover:text-[#F2C46A] dark:hover:text-[#F2C46A] transition-colors"
        >
          <svg class="w-3.5 h-3.5 shrink-0 text-[#F2C46A]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
          </svg>
          <span>{translations.footer.support}</span>
        </a>
      </div>
    </div>
  </div>
</footer>
