---
import { languages, getLocalizedPath } from '../i18n';
import type { Translations } from '../i18n';

interface Props {
  lang: string;
  translations: Translations;
}

const { lang, translations } = Astro.props;
const currentLang = languages.find((l) => l.code === lang) || languages[0];
---

<header class="sticky top-0 z-50 w-full bg-[#FCF0DA]/95 dark:bg-[#4C4541]/95 backdrop-blur-md border-b border-[#AEAC78]/30 dark:border-[#AEAC78]/20 transition-colors duration-200">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-2">
    <!-- Logo -->
    <a
      href={getLocalizedPath(lang, '/')}
      class="flex items-center gap-2 group text-[#4C4541] dark:text-[#FCF0DA] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F2C46A] rounded-lg p-1"
      aria-label="SavePrompt Home"
    >
      <div class="w-8 h-8 rounded-lg bg-[#F2C46A] text-[#4C4541] flex items-center justify-center font-bold shadow-sm transition-transform group-hover:scale-105">
        <!-- Bookmark icon -->
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </svg>
      </div>
      <span class="hidden md:inline text-lg font-bold tracking-tight text-[#4C4541] dark:text-[#FCF0DA]">SavePrompt</span>
    </a>

    <!-- Action Bar Controls -->
    <div class="flex items-center gap-1 sm:gap-2">
      <!-- 7-Language Selector Dropdown -->
      <div class="relative flex items-center">
        <label for="lang-select" class="sr-only">{translations.nav.language}</label>
        <div class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-[#AEAC78]/30 dark:border-[#AEAC78]/30 bg-[#FCF0DA]/80 dark:bg-[#4C4541]/80 hover:bg-[#AEAC78]/15 dark:hover:bg-[#AEAC78]/25 text-[#4C4541] dark:text-[#FCF0DA] transition-colors cursor-pointer text-xs sm:text-sm font-medium">
          <!-- Globe icon -->
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span class="px-1.5 py-0.5 rounded bg-[#AEAC78]/25 dark:bg-[#AEAC78]/30 text-[10px] font-bold tracking-wider">{currentLang.badge}</span>
          <span class="hidden md:inline text-xs">{currentLang.label}</span>
          <svg class="hidden md:inline w-3 h-3 opacity-60" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </div>
        <select
          id="lang-select"
          class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
          aria-label={translations.nav.language}
        >
          {languages.map(({ code, badge, label }) => (
            <option value={code} selected={code === lang}>
              [{badge}] {label}
            </option>
          ))}
        </select>
      </div>

      <!-- Light / Dark Mode Switcher -->
      <button
        id="theme-toggle"
        type="button"
        class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-[#AEAC78]/30 dark:border-[#AEAC78]/30 bg-[#FCF0DA]/80 dark:bg-[#4C4541]/80 hover:bg-[#AEAC78]/15 dark:hover:bg-[#AEAC78]/25 text-[#4C4541] dark:text-[#FCF0DA] transition-colors"
        aria-label={translations.nav.darkMode}
        title={translations.nav.darkMode}
      >
        <!-- Sun icon (shown in dark mode / triggers light) -->
        <svg class="icon-sun w-4 h-4 shrink-0 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (shown in light mode / triggers dark) -->
        <svg class="icon-moon w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <span class="hidden md:inline text-xs font-medium theme-toggle-text">{translations.nav.darkMode}</span>
      </button>

      <!-- Add to Home Screen PWA Install Button (subtle [+] icon) -->
      <button
        id="pwa-install-btn"
        type="button"
        class="hidden items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-[#F2C46A] bg-[#F2C46A]/20 hover:bg-[#F2C46A]/35 text-[#4C4541] dark:text-[#FCF0DA] transition-colors"
        aria-label={translations.nav.installApp}
        title={translations.nav.installApp}
      >
        <!-- Subtle [+] icon -->
        <svg class="w-4 h-4 shrink-0 text-[#4C4541] dark:text-[#F2C46A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="4" ry="4"></rect>
          <line x1="12" y1="8" x2="12" y2="16"></line>
          <line x1="8" y1="12" x2="16" y2="12"></line>
        </svg>
        <span class="hidden md:inline text-xs font-semibold">{translations.nav.installApp}</span>
      </button>

      <!-- Support the Developer CTA Button -->
      <a
        href="https://ko-fi.com/kishara"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#F2C46A] hover:bg-[#e5b85e] text-[#4C4541] font-semibold text-xs transition-colors shadow-sm"
        aria-label={translations.nav.support}
        title={translations.nav.support}
      >
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
        </svg>
        <span class="hidden md:inline">{translations.nav.support}</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  // Language switcher event handler
  document.addEventListener('DOMContentLoaded', () => {
    const langSelect = document.getElementById('lang-select');
    if (langSelect) {
      langSelect.addEventListener('change', (e) => {
        const selected = e.target.value;
        const targetUrl = selected === 'en' ? '/' : `/${selected}/`;
        window.location.href = targetUrl;
      });
    }
  });
</script>
