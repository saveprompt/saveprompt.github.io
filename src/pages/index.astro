---
import Layout from '../layouts/Layout.astro';
import PromptManager from '../components/PromptManager';
import { getTranslations } from '../i18n';

const lang = 'en';
const translations = getTranslations(lang);

const siteUrl = 'https://saveprompt.github.io';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${siteUrl}/`
    }
  ]
};

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "SavePrompt",
  "url": `${siteUrl}/`,
  "description": translations.meta.description,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Person",
    "name": "Kishara",
    "url": "https://ko-fi.com/kishara"
  },
  "publisher": {
    "@type": "Organization",
    "name": "SavePrompt",
    "url": `${siteUrl}/`
  },
  "image": `${siteUrl}/og-image.png`,
  "screenshot": `${siteUrl}/og-image.png`,
  "featureList": [
    "100% Client-Side LocalStorage Persistence",
    "Instant Search and Tag Filtering",
    "One-Click Clipboard Copying",
    "Progressive Web App (PWA) Offline Installation",
    "Local JSON Vault Backup and Restore",
    "Multi-Language Support Across 7 Languages",
    "Zero Tracking and Complete Privacy"
  ],
  "keywords": "AI prompt saver, free prompt organizer, offline prompt manager app, ChatGPT prompt manager, Claude prompt vault, prompt clipboard tool"
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": translations.seo.howToTitle,
  "description": "How to save, organize, and copy AI prompts using SavePrompt.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Enter prompt",
      "text": translations.seo.howToStep1
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Add optional tags",
      "text": translations.seo.howToStep2
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Save locally",
      "text": translations.seo.howToStep3
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "One-click copy",
      "text": translations.seo.howToStep4
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": translations.seo.faq1q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": translations.seo.faq1a
      }
    },
    {
      "@type": "Question",
      "name": translations.seo.faq2q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": translations.seo.faq2a
      }
    },
    {
      "@type": "Question",
      "name": translations.seo.faq3q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": translations.seo.faq3a
      }
    },
    {
      "@type": "Question",
      "name": translations.seo.faq4q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": translations.seo.faq4a
      }
    }
  ]
};
---

<Layout lang={lang} translations={translations}>
  <!-- Schema.org Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webApplicationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Semantic Breadcrumb Navigation -->
  <nav aria-label="Breadcrumb" class="mb-4">
    <ol class="flex items-center gap-1.5 text-xs text-[#4C4541]/60 dark:text-[#FCF0DA]/50">
      <li>
        <a href="/" class="hover:text-[#F2C46A] transition-colors font-medium">Home</a>
      </li>
      <li aria-hidden="true">/</li>
      <li class="text-[#4C4541] dark:text-[#FCF0DA] font-semibold" aria-current="page">AI Prompt Saver</li>
    </ol>
  </nav>

  <!-- Hero Header -->
  <header class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-[#4C4541] dark:text-[#FCF0DA] mb-3">
      {translations.app.heading}
    </h1>
    <p class="text-sm sm:text-base text-[#4C4541]/75 dark:text-[#FCF0DA]/75 font-medium leading-relaxed">
      {translations.app.subheading}
    </p>
  </header>

  <!-- React Island: Prompt Manager Vault -->
  <PromptManager client:load lang={lang} translations={translations.app} />

  <!-- SEO Semantic Features Section -->
  <section class="mt-16 pt-12 border-t border-[#AEAC78]/30 max-w-4xl mx-auto">
    <div class="text-center max-w-xl mx-auto mb-8">
      <h2 class="text-xl sm:text-2xl font-bold text-[#4C4541] dark:text-[#FCF0DA] mb-2">
        Why SavePrompt is the Best AI Prompt Saver
      </h2>
      <p class="text-xs sm:text-sm text-[#4C4541]/70 dark:text-[#FCF0DA]/70">
        Engineered for ChatGPT, Claude, Midjourney, and LLM practitioners who demand instant speed and complete privacy.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <article class="p-5 rounded-2xl border border-[#AEAC78]/30 bg-white/50 dark:bg-[#383330]/50 space-y-2">
        <div class="w-8 h-8 rounded-lg bg-[#F2C46A]/25 text-[#4C4541] dark:text-[#F2C46A] flex items-center justify-center font-bold text-sm">
          🔒
        </div>
        <h3 class="text-sm font-bold text-[#4C4541] dark:text-[#FCF0DA]">100% Local Privacy</h3>
        <p class="text-xs text-[#4C4541]/75 dark:text-[#FCF0DA]/70 leading-relaxed">
          Zero database connections and zero telemetry. All prompts persist exclusively in your device's browser LocalStorage.
        </p>
      </article>

      <article class="p-5 rounded-2xl border border-[#AEAC78]/30 bg-white/50 dark:bg-[#383330]/50 space-y-2">
        <div class="w-8 h-8 rounded-lg bg-[#F2C46A]/25 text-[#4C4541] dark:text-[#F2C46A] flex items-center justify-center font-bold text-sm">
          ⚡
        </div>
        <h3 class="text-sm font-bold text-[#4C4541] dark:text-[#FCF0DA]">1-Click Rapid Access</h3>
        <p class="text-xs text-[#4C4541]/75 dark:text-[#FCF0DA]/70 leading-relaxed">
          Search in real-time as you type, filter by tag pills, and copy directly to your clipboard in a single keystroke.
        </p>
      </article>

      <article class="p-5 rounded-2xl border border-[#AEAC78]/30 bg-white/50 dark:bg-[#383330]/50 space-y-2">
        <div class="w-8 h-8 rounded-lg bg-[#F2C46A]/25 text-[#4C4541] dark:text-[#F2C46A] flex items-center justify-center font-bold text-sm">
          📴
        </div>
        <h3 class="text-sm font-bold text-[#4C4541] dark:text-[#FCF0DA]">Offline-Ready PWA</h3>
        <p class="text-xs text-[#4C4541]/75 dark:text-[#FCF0DA]/70 leading-relaxed">
          Install as a standalone app on iOS, Android, macOS, or Windows with full offline support via service workers.
        </p>
      </article>
    </div>
  </section>

  <!-- SEO Semantic FAQ & How-To Section (Progressive Enhancement) -->
  <section class="mt-12 pt-10 border-t border-[#AEAC78]/30 max-w-3xl mx-auto space-y-12">
    <div>
      <h2 class="text-xl sm:text-2xl font-bold text-[#4C4541] dark:text-[#FCF0DA] mb-6">
        {translations.seo.howToTitle}
      </h2>
      <ol class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <li class="p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40">
          <span class="w-6 h-6 rounded-full bg-[#F2C46A] text-[#4C4541] font-bold text-xs inline-flex items-center justify-center mb-2">1</span>
          <p class="text-xs sm:text-sm text-[#4C4541]/85 dark:text-[#FCF0DA]/85">{translations.seo.howToStep1}</p>
        </li>
        <li class="p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40">
          <span class="w-6 h-6 rounded-full bg-[#F2C46A] text-[#4C4541] font-bold text-xs inline-flex items-center justify-center mb-2">2</span>
          <p class="text-xs sm:text-sm text-[#4C4541]/85 dark:text-[#FCF0DA]/85">{translations.seo.howToStep2}</p>
        </li>
        <li class="p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40">
          <span class="w-6 h-6 rounded-full bg-[#F2C46A] text-[#4C4541] font-bold text-xs inline-flex items-center justify-center mb-2">3</span>
          <p class="text-xs sm:text-sm text-[#4C4541]/85 dark:text-[#FCF0DA]/85">{translations.seo.howToStep3}</p>
        </li>
        <li class="p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40">
          <span class="w-6 h-6 rounded-full bg-[#F2C46A] text-[#4C4541] font-bold text-xs inline-flex items-center justify-center mb-2">4</span>
          <p class="text-xs sm:text-sm text-[#4C4541]/85 dark:text-[#FCF0DA]/85">{translations.seo.howToStep4}</p>
        </li>
      </ol>
    </div>

    <div>
      <h2 class="text-xl sm:text-2xl font-bold text-[#4C4541] dark:text-[#FCF0DA] mb-6">
        {translations.seo.faqTitle}
      </h2>
      <div class="space-y-4">
        <details class="group p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-[#4C4541] dark:text-[#FCF0DA] cursor-pointer">
            <span>{translations.seo.faq1q}</span>
            <span class="transition group-open:rotate-180">▾</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4C4541]/80 dark:text-[#FCF0DA]/80 leading-relaxed">
            {translations.seo.faq1a}
          </p>
        </details>

        <details class="group p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-[#4C4541] dark:text-[#FCF0DA] cursor-pointer">
            <span>{translations.seo.faq2q}</span>
            <span class="transition group-open:rotate-180">▾</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4C4541]/80 dark:text-[#FCF0DA]/80 leading-relaxed">
            {translations.seo.faq2a}
          </p>
        </details>

        <details class="group p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-[#4C4541] dark:text-[#FCF0DA] cursor-pointer">
            <span>{translations.seo.faq3q}</span>
            <span class="transition group-open:rotate-180">▾</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4C4541]/80 dark:text-[#FCF0DA]/80 leading-relaxed">
            {translations.seo.faq3a}
          </p>
        </details>

        <details class="group p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-[#4C4541] dark:text-[#FCF0DA] cursor-pointer">
            <span>{translations.seo.faq4q}</span>
            <span class="transition group-open:rotate-180">▾</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4C4541]/80 dark:text-[#FCF0DA]/80 leading-relaxed">
            {translations.seo.faq4a}
          </p>
        </details>
      </div>
    </div>
  </section>
</Layout>
