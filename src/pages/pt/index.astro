---
import Layout from '../../layouts/Layout.astro';
import PromptManager from '../../components/PromptManager';
import { getTranslations } from '../../i18n';

const lang = 'pt';
const translations = getTranslations(lang);
const siteUrl = 'https://saveprompt.github.io';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Português", "item": `${siteUrl}/pt/` }
  ]
};

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "SavePrompt",
  "url": `${siteUrl}/pt/`,
  "description": translations.meta.description,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "inLanguage": "pt",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "author": { "@type": "Person", "name": "Kishara", "url": "https://ko-fi.com/kishara" },
  "publisher": { "@type": "Organization", "name": "SavePrompt", "url": `${siteUrl}/` },
  "image": `${siteUrl}/og-image.png`,
  "screenshot": `${siteUrl}/og-image.png`,
  "featureList": [
    "Persistência 100% local com LocalStorage",
    "Busca em tempo real e filtro por tags",
    "Cópia para área de transferência em 1 clique",
    "PWA instalável e offline",
    "Exportação e backup JSON seguro",
    "Privacidade total sem rastreamento"
  ],
  "keywords": "salvar prompts IA, organizar prompts grátis, app gerenciador prompts offline"
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": translations.seo.howToTitle,
  "step": [
    { "@type": "HowToStep", "position": 1, "text": translations.seo.howToStep1 },
    { "@type": "HowToStep", "position": 2, "text": translations.seo.howToStep2 },
    { "@type": "HowToStep", "position": 3, "text": translations.seo.howToStep3 },
    { "@type": "HowToStep", "position": 4, "text": translations.seo.howToStep4 }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": translations.seo.faq1q, "acceptedAnswer": { "@type": "Answer", "text": translations.seo.faq1a } },
    { "@type": "Question", "name": translations.seo.faq2q, "acceptedAnswer": { "@type": "Answer", "text": translations.seo.faq2a } },
    { "@type": "Question", "name": translations.seo.faq3q, "acceptedAnswer": { "@type": "Answer", "text": translations.seo.faq3a } },
    { "@type": "Question", "name": translations.seo.faq4q, "acceptedAnswer": { "@type": "Answer", "text": translations.seo.faq4a } }
  ]
};
---

<Layout lang={lang} translations={translations}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webApplicationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <nav aria-label="Breadcrumb" class="mb-4">
    <ol class="flex items-center gap-1.5 text-xs text-[#4C4541]/60 dark:text-[#FCF0DA]/50">
      <li><a href="/" class="hover:text-[#F2C46A] transition-colors font-medium">Home</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-[#4C4541] dark:text-[#FCF0DA] font-semibold" aria-current="page">Português</li>
    </ol>
  </nav>

  <header class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-[#4C4541] dark:text-[#FCF0DA] mb-3">
      {translations.app.heading}
    </h1>
    <p class="text-sm sm:text-base text-[#4C4541]/75 dark:text-[#FCF0DA]/75 font-medium leading-relaxed">
      {translations.app.subheading}
    </p>
  </header>

  <PromptManager client:load lang={lang} translations={translations.app} />

  <section class="mt-16 pt-12 border-t border-[#AEAC78]/30 max-w-3xl mx-auto space-y-12">
    <div>
      <h2 class="text-xl sm:text-2xl font-bold text-[#4C4541] dark:text-[#FCF0DA] mb-6">
        {translations.seo.howToTitle}
      </h2>
      <ol class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <li class="p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40">
          <span class="w-6 h-6 rounded-full bg-[#F2C46A] text-[#4C4541] font-bold text-xs inline-flex items-center justify-center mb-2">1</span>
          <p class="text-xs sm:text-sm text-[#4C4541]/85 dark:text-[#FCF0DA]/85">{translations.seo.howToStep1}</p>
        </li>
        <li class="p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40">
          <span class="w-6 h-6 rounded-full bg-[#F2C46A] text-[#4C4541] font-bold text-xs inline-flex items-center justify-center mb-2">2</span>
          <p class="text-xs sm:text-sm text-[#4C4541]/85 dark:text-[#FCF0DA]/85">{translations.seo.howToStep2}</p>
        </li>
        <li class="p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40">
          <span class="w-6 h-6 rounded-full bg-[#F2C46A] text-[#4C4541] font-bold text-xs inline-flex items-center justify-center mb-2">3</span>
          <p class="text-xs sm:text-sm text-[#4C4541]/85 dark:text-[#FCF0DA]/85">{translations.seo.howToStep3}</p>
        </li>
        <li class="p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40">
          <span class="w-6 h-6 rounded-full bg-[#F2C46A] text-[#4C4541] font-bold text-xs inline-flex items-center justify-center mb-2">4</span>
          <p class="text-xs sm:text-sm text-[#4C4541]/85 dark:text-[#FCF0DA]/85">{translations.seo.howToStep4}</p>
        </li>
      </ol>
    </div>

    <div>
      <h2 class="text-xl sm:text-2xl font-bold text-[#4C4541] dark:text-[#FCF0DA] mb-6">
        {translations.seo.faqTitle}
      </h2>
      <div class="space-y-4">
        <details class="group p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-[#4C4541] dark:text-[#FCF0DA] cursor-pointer">
            <span>{translations.seo.faq1q}</span>
            <span class="transition group-open:rotate-180">▾</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4C4541]/80 dark:text-[#FCF0DA]/80 leading-relaxed">
            {translations.seo.faq1a}
          </p>
        </details>
        <details class="group p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-[#4C4541] dark:text-[#FCF0DA] cursor-pointer">
            <span>{translations.seo.faq2q}</span>
            <span class="transition group-open:rotate-180">▾</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4C4541]/80 dark:text-[#FCF0DA]/80 leading-relaxed">
            {translations.seo.faq2a}
          </p>
        </details>
        <details class="group p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-[#4C4541] dark:text-[#FCF0DA] cursor-pointer">
            <span>{translations.seo.faq3q}</span>
            <span class="transition group-open:rotate-180">▾</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4C4541]/80 dark:text-[#FCF0DA]/80 leading-relaxed">
            {translations.seo.faq3a}
          </p>
        </details>
        <details class="group p-4 rounded-xl border border-[#AEAC78]/30 bg-white/40 dark:bg-[#383330]/40 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-[#4C4541] dark:text-[#FCF0DA] cursor-pointer">
            <span>{translations.seo.faq4q}</span>
            <span class="transition group-open:rotate-180">▾</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4C4541]/80 dark:text-[#FCF0DA]/80 leading-relaxed">
            {translations.seo.faq4a}
          </p>
        </details>
      </div>
    </div>
  </section>
</Layout>
